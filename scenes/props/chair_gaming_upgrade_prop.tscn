[gd_scene load_steps=3 format=3 uid="uid://bchairgaming01"]

[sub_resource type="GDScript" id="GDScript_gaming_chair"]
script/source = "extends Node3D

func _ready() -> void:
	if get_child_count() > 0:
		return
	var sm := StyleMesh.new()
	# Base a 5 razze con ruote e pistone idraulico (orientamento locale: schienale su -Z, fronte su +Z)
	for i in range(5):
		var a := float(i) * TAU / 5.0
		var dir := Vector3(sin(a), 0.0, cos(a))
		sm.capsule_seg(\"iron\", Vector3(0, 0.075, 0), dir * 0.27 + Vector3(0, 0.045, 0), 0.022, 0.018, 8)
		sm.cyl(\"tire\", dir * 0.27, 0.026, 0.026, 0.040, 8)
	sm.cyl(\"iron\", Vector3(0, 0.07, 0), 0.036, 0.032, 0.28, 10)
	# Sedile ergonomico avvolgente (piano a Y=0.43)
	sm.ellipsoid(\"gaming_black\", Vector3(0, 0.39, 0.02), Vector3(0.24, 0.045, 0.23), 7, 16)
	sm.ellipsoid(\"cyan_accent\", Vector3(0, 0.425, 0.03), Vector3(0.18, 0.018, 0.17), 5, 14)
	# Braccioli sagomati
	for sx in [-0.265, 0.265]:
		sm.capsule_seg(\"iron\", Vector3(sx, 0.37, 0.02), Vector3(sx, 0.57, 0.02), 0.018, 0.018, 8)
		sm.ellipsoid(\"gaming_black\", Vector3(sx, 0.59, 0.05), Vector3(0.036, 0.022, 0.14), 5, 10)
	# Schienale alto da gaming su -Z (inclinato leggermente indietro)
	sm.capsule_seg(\"gaming_black\", Vector3(0, 0.42, -0.21), Vector3(0, 1.06, -0.26), 0.21, 0.17, 14)
	sm.ellipsoid(\"gaming_black\", Vector3(0, 0.78, -0.21), Vector3(0.24, 0.30, 0.055), 8, 16, Vector3(0.08, 0, 0))
	sm.ellipsoid(\"cyan_accent\", Vector3(0, 0.99, -0.18), Vector3(0.11, 0.055, 0.040), 6, 12)
	sm.ellipsoid(\"cyan_accent\", Vector3(0, 0.52, -0.155), Vector3(0.13, 0.055, 0.040), 6, 12)

	var mi := MeshInstance3D.new()
	mi.name = \"GamingChairMesh\"
	mi.mesh = sm.to_mesh(Callable(VillageMaterials, \"mat\"))
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	add_child(mi)
"

