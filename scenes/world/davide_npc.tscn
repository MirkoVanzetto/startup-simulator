[sub_resource type="GDScript" id="GDScript_anim"]
script/source = "extends Node

func _ready() -> void:
	_hide_weapons()
	_play_idle()
	var parent = get_parent()
	if parent is Interactable3D:
		parent.interacted.connect(_on_interacted)

func _hide_weapons() -> void:
	var model = get_parent().get_node_or_null(\"Model\")
	if model:
		for child in model.find_children(\"*\", \"MeshInstance3D\", true, false):
			var n = child.name.to_lower()
			if \"sword\" in n or \"shield\" in n or \"staff\" in n or \"wand\" in n or \"axe\" in n or \"crossbow\" in n or \"knife\" in n:
				child.visible = false

func _play_idle() -> void:
	var model = get_parent().get_node_or_null(\"Model\")
	if model:
		var ap: AnimationPlayer = model.find_child(\"AnimationPlayer\", true, false)
		if ap:
			for anim_name in [\"Idle\", \"Unarmed_Idle\", \"idle\"]:
				if ap.has_animation(anim_name):
					var a = ap.get_animation(anim_name)
					if a:
						a.loop_mode = Animation.LOOP_LINEAR
					ap.play(anim_name)
					break

func _on_interacted(_player: Node) -> void:
	var model = get_parent().get_node_or_null(\"Model\")
	if model:
		var ap: AnimationPlayer = model.find_child(\"AnimationPlayer\", true, false)
		if ap:
			for anim in [\"Interact\", \"interact\", \"Cheer\", \"cheer\"]:
				if ap.has_animation(anim):
					ap.play(anim)
					if not ap.animation_finished.is_connected(_on_anim_finished):
						ap.animation_finished.connect(_on_anim_finished, CONNECT_ONE_SHOT)
					return

func _on_anim_finished(_anim_name: String) -> void:
	_play_idle()
"

