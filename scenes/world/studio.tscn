[sub_resource type="GDScript" id="GDScript_luca_anim"]
script/source = "extends Node

func _ready() -> void:
	_hide_weapons()
	_play_sitting()

func _hide_weapons() -> void:
	var model = get_parent()
	for child in model.find_children(\"*\", \"MeshInstance3D\", true, false):
		var n = child.name.to_lower()
		if \"sword\" in n or \"shield\" in n or \"staff\" in n or \"wand\" in n or \"axe\" in n or \"crossbow\" in n or \"knife\" in n or \"throwable\" in n or \"potion\" in n or \"flask\" in n:
			child.visible = false

func _play_sitting() -> void:
	var model = get_parent()
	var ap: AnimationPlayer = model.find_child(\"AnimationPlayer\", true, false)
	if ap:
		for anim_name in [\"Sit_Chair_Idle\", \"Idle\", \"idle\"]:
			if ap.has_animation(anim_name):
				var a = ap.get_animation(anim_name)
				if a:
					a.loop_mode = Animation.LOOP_LINEAR
				ap.play(anim_name)
				break
"

