[sub_resource type="GDScript" id="GDScript_luca_sculpted"]
script/source = "extends Node3D

func _ready() -> void:
	if find_child(\"BodyMesh\", true, false) == null:
		VillageCharacters.build(self, {
			\"seated\": true,
			\"shirt\": \"hoodie_teal\",
			\"pants\": \"denim\",
			\"hair\": \"hair_brown\",
			\"iris\": \"iris_brown\",
			\"hair_style\": \"quiff\",
			\"glasses\": true,
		})
"

